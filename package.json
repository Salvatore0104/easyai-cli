{
  "name": "@easyai/cli",
  "version": "0.6.0",
  "description": "Codex-driven visual design agent for images, brands, products, illustration, video and stage visuals",
  "type": "module",
  "bin": {
    "wowidea": "dist/cli.js",
    "easyai": "dist/cli.js",
    "easyai-canvas": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "openapi",
    "docs",
    "scripts"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean --external keytar",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run resources:check && npm run typecheck && npm run build && npm test",
    "pack:check": "npm pack --dry-run",
    "package:host": "npm run build && node scripts/package-host.mjs",
    "resources:check": "node scripts/check-resources.mjs",
    "resources:lock": "node scripts/check-resources.mjs --update",
    "prepack": "npm run resources:check",
    "package:smoke": "node scripts/smoke-package.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "commander": "^14.0.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@yao-pkg/pkg": "^6.22.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pkg": {
    "scripts": [
      "dist/*.js"
    ],
    "assets": [
      "node_modules/keytar/build/Release/*.node",
      "skill/**/*"
    ]
  }
}
